{
  "name": "fronttier",
  "productName": "Fronttier",
  "version": "1.0.0",
  "description": "Navegador multipanel para desarrollo web responsivo, accesible y rápido",
  "main": "dist/main.js",
  "author": "luisfalconmx <luisfalconmx@gmail.com>",
  "homepage": "https://github.com/luisfalconmx/fronttier",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --dev && electron .",
    "start": "node scripts/build.mjs && electron .",
    "typecheck": "tsc --noEmit -p .",
    "icon": "node scripts/make-icon.mjs",
    "dist:win": "node scripts/build.mjs && electron-builder --win nsis portable --x64",
    "dist:mac": "node scripts/build.mjs && electron-builder --mac dmg zip --arm64 --x64",
    "dist:linux": "node scripts/build.mjs && electron-builder --linux AppImage deb --x64",
    "dist:all": "node scripts/build.mjs && electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "axe-core": "^4.14.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "qrcode-generator": "^2.0.4",
    "typescript": "^5.9.0",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "dev.fronttier.browser",
    "productName": "Fronttier",
    "copyright": "MIT",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "electronLanguages": [
      "en-US",
      "es",
      "es-419"
    ],
    "icon": "build/icon.png",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fronttier",
      "artifactName": "Fronttier-Setup-${version}-win-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "Fronttier-Portable-${version}-win-${arch}.exe",
      "requestExecutionLevel": "user"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Fronttier-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "luisfalconmx <luisfalconmx@gmail.com>",
      "synopsis": "Navegador multipanel para desarrollo web",
      "artifactName": "Fronttier-${version}-linux-${arch}.${ext}"
    },
    "toolsets": {
      "nsis": "1.2.1",
      "appimage": "1.0.3"
    }
  }
}
